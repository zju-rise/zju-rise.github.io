---
/**
 * @file src/pages/people/index.astro
 * @purpose Faculty overview and photo-first grids for all member categories.
 * @maintain Set group/order in content/people; categories with no entries are omitted.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBar from '../../components/SectionBar.astro';
import MemberCard from '../../components/MemberCard.astro';
import { getPeople, groupLabels } from '../../lib/content';
import { editorial } from '../../config/editorial';
const people = await getPeople();
const groups = Object.entries(groupLabels) as [keyof typeof groupLabels, string][];
---
<BaseLayout title="People">
  <h1>People</h1>
  {groups.map(([group, label]) => {
    const members = people.filter((person) => person.data.group === group);
    return members.length > 0 && <section class="people-section" aria-labelledby={`group-${group}`}>
      <SectionBar title={label} id={`group-${group}`} />
      {group === 'faculty' ? members.map((person) => (
        <div class="faculty-overview">
          <MemberCard person={person} large />
          <div class="faculty-summary">
            <h3>{person.data.name}</h3>
            {/* Keep each faculty member's overview in their own Markdown record. */}
            {person.data.facultySummary.length > 0
              ? person.data.facultySummary.map((paragraph) => <p>{paragraph}</p>)
              : <p>{editorial.facultyOverview}</p>}
            <p><strong>Research directions</strong><br />{person.data.interests}</p>
          </div>
        </div>
      )) : <div class="member-grid">{members.map((person) => <MemberCard person={person} />)}</div>}
    </section>;
  })}
  {!people.length && <p class="empty-message">Meet the group here as member profiles are added.</p>}
</BaseLayout>
