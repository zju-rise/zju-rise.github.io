---
/**
 * @file src/components/MemberCard.astro
 * @purpose Member card linking only to the member's own optional website.
 * @maintain Set website in content/people; missing URLs render inert text/photos.
 */
import type { CollectionEntry } from 'astro:content';
import Portrait from './Portrait.astro';
interface Props { person: CollectionEntry<'people'>; large?: boolean }
const { person, large = false } = Astro.props;
const { data } = person;
---
<article class:list={['member-card', { 'member-card-faculty': large }]}>
  {data.website
    ? <a class="portrait-link" href={data.website} aria-label={`Visit ${data.name}'s homepage`}><Portrait name={data.name} photo={data.photo} large={large} /></a>
    : <div class="portrait-link"><Portrait name={data.name} photo={data.photo} large={large} /></div>}
  <h3>{data.website ? <a href={data.website}>{data.name}</a> : <span>{data.name}</span>}</h3>
  <p class="member-role">{data.role}</p>
  <p class="member-interests">{data.group === 'alumni' ? data.affiliation : data.interests}</p>
  {large && (data.website ? <a class="small-link" href={data.website}>Personal homepage</a> : <span class="small-link">Personal homepage</span>)}
</article>
