# @file: .editorconfig
# @purpose: Consistent UTF-8, indentation and newlines for future maintainers.
# @maintain: Follow these defaults when adding source and content files.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
